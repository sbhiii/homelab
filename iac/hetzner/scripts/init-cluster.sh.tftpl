#!/bin/bash
# 1. Dependencies & optimizations
apt-get update
#  && apt-get install -y curl fuse3 open-iscsi nfs-common
echo "fs.inotify.max_user_instances=524288" >> /etc/sysctl.d/99-kubernetes.conf
sysctl -p /etc/sysctl.d/99-kubernetes.conf

# 2. preparing k3s folder
# K3s applies everything placed here, in alphabetical order
mkdir -p /var/lib/rancher/k3s/server/manifests/

# 3. injection of argocd manifests through terraform
cat <<EOF > /var/lib/rancher/k3s/server/manifests/01-argocd-helm.yaml
${argocd_manifest}
EOF

cat <<EOF > /var/lib/rancher/k3s/server/manifests/02-argocd-repo-secret.yaml
${argocd_repo_secret}
EOF

cat <<EOF > /var/lib/rancher/k3s/server/manifests/03-argocd-root-app.yaml
${argocd_root_app}
EOF

# 3b. ServiceAccount token-signing key (supplied by Terraform)
mkdir -p /etc/k3s-oidc
cat <<'EOF' > /etc/k3s-oidc/sa.key
${sa_private_key}
EOF
cat <<'EOF' > /etc/k3s-oidc/sa.pub
${sa_public_key}
EOF
chmod 600 /etc/k3s-oidc/sa.key
chmod 644 /etc/k3s-oidc/sa.pub
chown root:root /etc/k3s-oidc/sa.key /etc/k3s-oidc/sa.pub

# 4. Installation K3s
PUBLIC_IP=$(curl -s http://169.254.169.254/hetzner/v1/metadata/public-ipv4)
curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server \
  --tls-san $PUBLIC_IP \
  --write-kubeconfig-mode 644 \
  --disable traefik \
  --disable servicelb \
  --kube-apiserver-arg=service-account-issuer=${oidc_issuer_url} \
  --kube-apiserver-arg=service-account-signing-key-file=/etc/k3s-oidc/sa.key \
  --kube-apiserver-arg=service-account-key-file=/etc/k3s-oidc/sa.pub \
  --kube-apiserver-arg=api-audiences=${oidc_issuer_url},sts.amazonaws.com" sh -s -

# 5. Deny pods access to the metadata service
#
# Hetzner serves user_data unauthenticated on 169.254.169.254, and that user_data
# carries both the ServiceAccount token-signing key and the GitHub PAT. Without
# this rule any pod can read them, forge a token for any ServiceAccount, and push
# to the gitops repository.
#
# The FORWARD chain only sees traffic *transiting* the node, which is precisely
# pod traffic. The node itself goes through OUTPUT and keeps its access - it needs
# it above to fetch its public IP. Infrastructure DaemonSets running with
# hostNetwork (CSI, CCM) also go through OUTPUT and are therefore unaffected.
#
# A systemd unit rather than a bare command: this cloud-init script runs only at
# first boot, so the rule would be lost on the first reboot.
cat <<'EOF' > /etc/systemd/system/block-pod-metadata.service
[Unit]
Description=Deny the pod network access to the metadata service
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
# -C tests whether the rule is already present, making the unit idempotent.
ExecStart=/bin/sh -c '/usr/sbin/iptables -C FORWARD -s 10.42.0.0/16 -d 169.254.169.254 -j DROP 2>/dev/null || /usr/sbin/iptables -I FORWARD -s 10.42.0.0/16 -d 169.254.169.254 -j DROP'

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now block-pod-metadata.service